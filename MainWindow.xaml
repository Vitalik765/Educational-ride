<Window x:Class="SoftwareProductsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoftwareProductsManager"
        Title="Сопровождение ИС электронных платежей"
        Height="820" Width="1280"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Операционный центр сопровождения платежей" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Мониторинг, управление данными и аудит записей в едином рабочем окне" Margin="0,4,0,0" Foreground="#4B5563"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserInfoText" Text="Пользователь:" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    <Button x:Name="LogoutButton" Content="Выйти из системы" Width="150" Margin="0,8,0,0" Click="LogoutButton_Click" Style="{StaticResource OutlineButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainWorkspaceTabs" Grid.Row="1" Margin="0,0,0,0" SelectionChanged="MainWorkspaceTabs_SelectionChanged">
            <TabItem Header="Часть 1 — Операции с данными">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="14">
                <StackPanel>
                    <TextBlock Text="Навигация по сущностям" FontWeight="Bold" FontSize="16" Foreground="#111827"/>
                    <TextBlock Text="Выберите таблицу для работы" Margin="0,3,0,10" Foreground="#6B7280"/>
                    <ComboBox x:Name="TableSelector" SelectionChanged="TableSelector_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding TableName}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding RowCount, StringFormat=Записей: {0}}" Foreground="#6B7280" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                        <Button x:Name="AddButton" Style="{StaticResource ActionButton}" Click="AddRecord_Click" Content="Добавить"/>
                        <Button x:Name="EditButton" Style="{StaticResource ActionButton}" Background="#2563EB" Click="EditRecord_Click" Content="Редактировать"/>
                        <Button x:Name="DeleteButton" Style="{StaticResource ActionButton}" Background="#DC2626" Click="DeleteRecord_Click" Content="Удалить"/>
                        <Button Style="{StaticResource OutlineButton}" Click="RefreshData_Click" Content="Обновить"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox"
                                 TextChanged="SearchTextBox_TextChanged"
                                 GotFocus="SearchTextBox_GotFocus"
                                 LostFocus="SearchTextBox_LostFocus"
                                 Padding="10,7"
                                 BorderThickness="1">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <Grid>
                                            <TextBlock x:Name="PlaceholderText"
                                                       Text="Поиск по полям таблицы"
                                                       Foreground="#9CA3AF"
                                                       Margin="10,7"
                                                       IsHitTestVisible="False"
                                                       Visibility="Visible"/>
                                            <ScrollViewer x:Name="PART_ContentHost" Padding="10,7"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button Grid.Column="1" Content="Очистить" Margin="8,0,0,0" Click="ClearSearch_Click" Style="{StaticResource OutlineButton}"/>
                    </Grid>

                    <DataGrid x:Name="ProductsDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="True"
                              SelectionChanged="ProductsDataGrid_SelectionChanged"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              GridLinesVisibility="Horizontal"
                              RowBackground="White"
                              AlternatingRowBackground="#F9FAFB"
                              HeadersVisibility="Column"
                              IsReadOnly="True"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Карточка записи" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                    <ScrollViewer Grid.Row="1" x:Name="DetailsScrollViewer" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel x:Name="RecordDetailsPanel" Visibility="Collapsed">
                                <TextBlock x:Name="DetailsTitle" Text="Детали записи" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" Foreground="#111827"/>
                                <StackPanel x:Name="DynamicFieldsPanel"/>
                            </StackPanel>
                            <StackPanel x:Name="NoSelectionPanel">
                                <TextBlock Text="Выберите строку в таблице, чтобы открыть подробности." TextWrapping="Wrap" Foreground="#6B7280" Margin="0,16,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
            </TabItem>
            <TabItem Header="Часть 2 — Мониторинг и отчёты">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,0,12">
                        <Run Text="Сводка по таблицам и отчёт по распределению значений колонки результата. В списке даты первым идёт пункт «вся таблица» — для таблиц без даты (например «Карты»). Иначе выберите колонку даты и период."/>
                    </TextBlock>

                    <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Сводка по таблицам" FontWeight="Bold" FontSize="16" Foreground="#111827" VerticalAlignment="Center"/>
                                <Button Content="Обновить сводку" Margin="16,0,0,0" Click="Part2RefreshSummary_Click" Style="{StaticResource ActionButton}"/>
                            </StackPanel>
                            <DataGrid x:Name="Part2SummaryGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" BorderBrush="#E5E7EB" GridLinesVisibility="Horizontal" HeadersVisibility="Column"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Отчёт по результатам" FontWeight="Bold" FontSize="16" Foreground="#111827" Grid.ColumnSpan="5" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Таблица" Foreground="#6B7280" FontSize="12"/>
                                <ComboBox x:Name="Part2ReportTableCombo" Margin="0,4,0,0"
                                          IsSynchronizedWithCurrentItem="False"
                                          SelectionChanged="Part2ReportTableCombo_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Дата с" Foreground="#6B7280" FontSize="12"/>
                                <DatePicker x:Name="Part2DateFrom" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Дата по" Foreground="#6B7280" FontSize="12"/>
                                <DatePicker x:Name="Part2DateTo" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="3" Content="Построить" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="Part2BuildReport_Click" Style="{StaticResource ActionButton}"/>
                            <Button Grid.Row="1" Grid.Column="4" Content="Экспорт CSV" VerticalAlignment="Bottom" Click="Part2ExportCsv_Click" Style="{StaticResource OutlineButton}"/>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,8,0">
                                <TextBlock Text="Колонка даты (фильтр периода)" Foreground="#6B7280" FontSize="12"/>
                                <ComboBox x:Name="Part2DateColumnCombo" Margin="0,4,0,0" IsEditable="False"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="8,10,0,0">
                                <TextBlock Text="Колонка результата (группировка)" Foreground="#6B7280" FontSize="12"/>
                                <ComboBox x:Name="Part2ResultColumnCombo" Margin="0,4,0,0" IsEditable="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="12">
                        <DataGrid x:Name="Part2ReportGrid" AutoGenerateColumns="True" IsReadOnly="True" BorderBrush="#E5E7EB" GridLinesVisibility="Horizontal" HeadersVisibility="Column"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="Система готова к работе" Foreground="#1F2937"/>
                <TextBlock Text="  |  " Foreground="#9CA3AF"/>
                <TextBlock x:Name="ConnectionStatus" Text="База данных подключена" Foreground="#0F766E" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

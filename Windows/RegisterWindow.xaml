<Window x:Class="SoftwareProductsManager.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="700" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Стили для кнопок -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D9488"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F766E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для PasswordBox -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Margin="14,14,14,0" Padding="16,12">
            <TextBlock Text="Регистрация сотрудника сопровождения" FontSize="21" FontWeight="Bold" Foreground="#111827"/>
        </Border>
        
        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16" VerticalAlignment="Top">
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <!-- Имя пользователя -->
                        <TextBlock Text="Имя пользователя:" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,8"
                               Foreground="#111111"/>
                        <TextBox x:Name="UsernameTextBox" 
                                 Style="{StaticResource ModernTextBox}"
                                 Height="45"
                                 Margin="0,0,0,25"/>
                        
                        <!-- Email -->
                        <TextBlock Text="Email:" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,8"
                                   Foreground="#111111"/>
                        <TextBox x:Name="EmailTextBox" 
                                 Style="{StaticResource ModernTextBox}"
                                 Height="45"
                                 Margin="0,0,0,25"/>
                        
                        <!-- Имя -->
                        <TextBlock Text="Имя (необязательно):" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,8"
                                   Foreground="#111111"/>
                        <TextBox x:Name="FirstNameTextBox" 
                                 Style="{StaticResource ModernTextBox}"
                                 Height="45"
                                 Margin="0,0,0,25"/>
                        
                        <!-- Фамилия -->
                        <TextBlock Text="Фамилия (необязательно):" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,8"
                                   Foreground="#111111"/>
                        <TextBox x:Name="LastNameTextBox" 
                                 Style="{StaticResource ModernTextBox}"
                                 Height="45"
                                 Margin="0,0,0,25"/>
                        
                        <!-- Пароль -->
                        <TextBlock Text="Пароль:" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,8"
                                   Foreground="#111111"/>
                        <PasswordBox x:Name="PasswordBox" 
                                     Style="{StaticResource ModernPasswordBox}"
                                     Height="45"
                                     Margin="0,0,0,25"/>
                        
                        <!-- Подтверждение пароля -->
                        <TextBlock Text="Подтверждение пароля:" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Margin="0,0,0,8"
                                   Foreground="#111111"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" 
                                     Style="{StaticResource ModernPasswordBox}"
                                     Height="45"
                                     Margin="0,0,0,35"/>
                        
                        <!-- Кнопки -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button x:Name="RegisterButton" 
                                    Content="✅ Зарегистрироваться" 
                                    Width="180"
                                    Height="50"
                                    Click="RegisterButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="CancelButton" 
                                    Content="❌ Отмена" 
                                    Width="140"
                                    Height="50"
                                    Click="CancelButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                        <Setter Property="Background" Value="#8E2A44"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#6B1F33"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- Статус -->
        <Border Grid.Row="2" Background="#F3F4F6" Padding="15,10">
            <TextBlock x:Name="StatusText" 
                       Text="Заполните все обязательные поля" 
                       HorizontalAlignment="Center" 
                       Foreground="#111111"
                       FontSize="14"/>
        </Border>
    </Grid>
</Window>

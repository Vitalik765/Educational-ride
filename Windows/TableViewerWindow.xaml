<Window x:Class="SoftwareProductsManager.Windows.TableViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр таблиц базы данных" 
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A1020">
    
    <Window.Resources>
        <!-- Стили для кнопок -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D9488"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F766E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EFEFEF"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FCFCFC"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Padding="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0F766E" Offset="0"/>
                    <GradientStop Color="#0EA5A4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="24" Margin="0,0,10,0"/>
                <TextBlock Text="Обзор сущностей платежной системы" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"/>
            </StackPanel>
            </Border>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Список таблиц -->
            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="15" BorderBrush="#D1D5DB" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Сущности в базе данных:" 
                              FontSize="16" FontWeight="Bold" 
                              Margin="0,0,0,15" Foreground="#D3E6FF"/>

                    <ListBox x:Name="TablesListBox" 
                            Grid.Row="1"
                            SelectionChanged="TablesListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding TableName}" 
                                              FontWeight="Bold" 
                                              FontSize="14"/>
                                    <TextBlock Text="{Binding RowCount, StringFormat='Записей: {0}'}" 
                                              FontSize="12" 
                                              Foreground="#6B7280"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Данные таблицы -->
            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="15" BorderBrush="#D1D5DB" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock x:Name="SelectedTableName" 
                                  Text="Выберите сущность"
                                  FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedTableCount" 
                                  Text="" 
                                  FontSize="14" 
                                  Foreground="#6B7280" 
                                  Margin="10,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="TableDataGrid" 
                             Grid.Row="1"
                             Style="{StaticResource ModernDataGrid}"
                             AutoGenerateColumns="True"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <Border Grid.Row="2" Background="#F3F4F6" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="Аналитический режим готов" Margin="0,0,20,0" Foreground="#1F2937"/>
                <TextBlock Text="● Подключено" Foreground="#5BDE98"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="SoftwareProductsManager.Windows.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование карточки компонента"
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F8FA">
    
    <Window.Resources>
        <!-- Стили для кнопок -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C7CCD4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки отмены -->
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Стиль для DatePicker -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Padding="0">
            <Border.Background>
                <SolidColorBrush Color="#FFFFFF"/>
            </Border.Background>
            <Border BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
            <Border Padding="20,15">
            <TextBlock x:Name="WindowTitle" 
                      Text="Добавление карточки компонента"
                      FontSize="20" 
                      FontWeight="Bold" 
                      Foreground="#111111"/>
            </Border>
            </Border>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel>
                <!-- Название -->
                <TextBlock Text="Наименование компонента *" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <TextBox x:Name="NameTextBox" 
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,15"/>

                <!-- Описание -->
                <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <TextBox x:Name="DescriptionTextBox" 
                        Style="{StaticResource ModernTextBox}"
                        Height="60"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,15"/>

                <!-- Время приготовления -->
                <TextBlock Text="Версия/релиз" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <TextBox x:Name="VersionTextBox" 
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,15"/>

                <!-- Автор -->
                <TextBlock Text="Ответственная команда" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <TextBox x:Name="DeveloperTextBox" 
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,15"/>

                <!-- Категория -->
                <TextBlock Text="Категория модуля" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <ComboBox x:Name="CategoryComboBox" 
                         Style="{StaticResource ModernComboBox}"
                         IsEditable="True"
                         Margin="0,0,0,15">
                    <ComboBoxItem Content="Мониторинг транзакций"/>
                    <ComboBoxItem Content="Инцидент-менеджмент"/>
                    <ComboBoxItem Content="Антифрод"/>
                    <ComboBoxItem Content="Биллинг"/>
                    <ComboBoxItem Content="Интеграции и API"/>
                    <ComboBoxItem Content="Отчетность"/>
                    <ComboBoxItem Content="Безопасность"/>
                    <ComboBoxItem Content="Другое"/>
                </ComboBox>

                <!-- Себестоимость -->
                <TextBlock Text="Эксплуатационные затраты (руб.)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <TextBox x:Name="PriceTextBox" 
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,15"/>

                <!-- Дата добавления -->
                <TextBlock Text="Дата ввода в сопровождение" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <DatePicker x:Name="ReleaseDatePicker" 
                           Style="{StaticResource ModernDatePicker}"
                           SelectedDate="{x:Static sys:DateTime.Today}"
                           Margin="0,0,0,15"
                           xmlns:sys="clr-namespace:System;assembly=mscorlib"/>

                <!-- Кухня -->
                <TextBlock Text="Модель лицензирования" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <ComboBox x:Name="LicenseComboBox" 
                         Style="{StaticResource ModernComboBox}"
                         IsEditable="True"
                         Margin="0,0,0,15">
                    <ComboBoxItem Content="Коммерческая"/>
                    <ComboBoxItem Content="Подписка"/>
                    <ComboBoxItem Content="Open Source"/>
                    <ComboBoxItem Content="Внутренняя"/>
                    <ComboBoxItem Content="Индивидуальная"/>
                </ComboBox>

                <!-- Ингредиенты -->
                <TextBlock Text="Технические требования и регламенты" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827"/>
                <TextBox x:Name="SystemRequirementsTextBox" 
                        Style="{StaticResource ModernTextBox}"
                        Height="60"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,15"/>

                <!-- Активность -->
                <CheckBox x:Name="IsActiveCheckBox" 
                         Content="Компонент активен" 
                         Foreground="#111827"
                         IsChecked="True"
                         FontWeight="SemiBold"
                         Margin="0,0,0,15"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#F3F4F6" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" 
                       Style="{StaticResource ModernButton}"
                       Click="Save_Click"/>
                <Button Content="Отмена" 
                       Style="{StaticResource CancelButton}"
                       Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
